# 공공데이터포털에서 행정안전부_식품_일반음식점 조회서비스 활용신청 후 '디코딩' 인증키 입력
DATA_GO_KR_KEY=여기에_발급받은_디코딩_인증키
# REST API 매뉴얼의 상세 파라미터가 다른 경우 변경할 수 있습니다.
API_URL=https://apis.data.go.kr/1741000/general_restaurants/info
PAGE_SIZE=1000
MAX_PAGES=10000
REQUEST_DELAY_MS=180
# 옵션: API 명세에서 지원하는 지역 필터의 정확한 필드명/값 확인 시 입력. 값 없으면 전체 페이지를 조회 후 중구만 추출.
API_REGION_FIELD=
API_REGION_VALUE=
